# --- Routing -----------------------------------------------------------------
# Multi-model: a JSON list of models this gateway serves. Each entry names a
# provider kind from the registry (anthropic | gemini | ollama | openai). When
# set, this supersedes the single-model block below.
#
# GATEWAY_MODELS='[
#   {"name": "opus-5",     "kind": "anthropic", "upstream_model": "claude-opus-5"},
#   {"name": "sonnet-5",   "kind": "anthropic", "upstream_model": "claude-sonnet-5"},
#   {"name": "gpt-5",      "kind": "openai",    "upstream_model": "gpt-5"},
#   {"name": "gemini-pro", "kind": "gemini",    "upstream_model": "gemini-2.5-pro"},
#   {"name": "local",      "kind": "ollama",    "upstream_model": "llama3.2"}
# ]'
#
# Optional per-entry keys: "base_url", "api_key", "provider_name".
GATEWAY_MODELS=

# Single-model configuration. Used only when GATEWAY_MODELS is empty.
GATEWAY_PROVIDER_KIND=ollama
# Label used in logs and metrics; safe to set per deployment.
GATEWAY_PROVIDER_NAME=upstream
GATEWAY_PUBLIC_MODEL=gateway-model
GATEWAY_UPSTREAM_MODEL=llama3.2
# Optional. Defaults to the registry entry for the configured provider kind.
GATEWAY_UPSTREAM_BASE_URL=

# --- Credentials -------------------------------------------------------------
# Per-provider keys, read under their standard names so a machine already set up
# for these SDKs needs nothing gateway-specific. Resolution order per model:
#   the entry's own "api_key" -> the provider kind's variable below -> the
#   shared GATEWAY_UPSTREAM_API_KEY. A blank value counts as unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Fallback for kinds with no variable of their own (e.g. a remote ollama).
GATEWAY_UPSTREAM_API_KEY=
# Required from clients as "Authorization: Bearer ...". Empty disables auth.
GATEWAY_API_KEY=

# --- Development -------------------------------------------------------------
# Serves the request console at /__dev/console. Never enable in production.
GATEWAY_DEV_CONSOLE=false

# --- Limits ------------------------------------------------------------------
# Applied when the provider requires max_tokens and the caller omitted it, which
# today means Anthropic only. Reasoning tokens are billed against this cap, so a
# small value returns an empty answer with finish_reason=length.
GATEWAY_DEFAULT_MAX_TOKENS=8192
GATEWAY_CONNECT_TIMEOUT_S=5
GATEWAY_FIRST_TOKEN_TIMEOUT_S=30
# Armed against gateway events, not upstream bytes: a model that reasons before
# it speaks emits nothing for this long and the stream is cut.
GATEWAY_IDLE_TIMEOUT_S=20
GATEWAY_TOTAL_TIMEOUT_S=300
GATEWAY_LOG_LEVEL=INFO
